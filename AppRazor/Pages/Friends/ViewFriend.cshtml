@page
@using Models.DTO
@model AppRazor.Pages.Friends.ViewFriendModel
@{
    ViewData["Title"] = "View friend";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<div class="container px-4 py-4" id="view-friend">
    <h2 class="pb-2 border-bottom">
        Details
        <a href="~/Members/EditFriend?id=@Model.Friend?.FriendId">
            <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em">
                <use xlink:href="#edit" />
            </svg>
        </a>
    </h2>
    <form class="needs-validation" novalidate>
        <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
            <div class="col-md-7 col-lg-10">

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label for="firstname" class="form-label">Firstname</label>
                        <input type="text" class="form-control" id="firstname" value="@Model.Friend?.FirstName"
                            readonly>
                    </div>
                    <div class="col-sm-6">
                        <label for="lastname" class="form-label">Lastname</label>
                        <input type="text" class="form-control" id="lastname" value="@Model.Friend?.LastName" readonly>
                    </div>
                    <div class="col-sm-6">
                        <label for="birthday" class="form-label">Birthday</label>
                        <input type="text" class="form-control" id="birthday"
                            value="@(Model.Friend?.Birthday.HasValue == true ? Model.Friend.Birthday.Value.ToString("yyyy-MM-dd") : "")"
                            readonly>
                    </div>
                </div>

                <div class="row g-3 mt-4">
                    <div class="col-sm-6">
                        <label for="streetaddress" class="form-label">Street Address</label>
                        <input type="text" class="form-control" id="streetaddress"
                            value="@Model.Friend?.Address?.StreetAddress" readonly>
                    </div>
                    <div class="col-sm-3">
                        <label for="zipcode" class="form-label">Zip Code</label>
                        <input type="text" class="form-control" id="zipcode"
                            value="@(Model.Friend?.Address != null ? Model.Friend.Address.ZipCode.ToString() : "")"
                            readonly>
                    </div>
                    <div class="col-sm-3">
                        <label for="city" class="form-label">City</label>
                        <input type="text" class="form-control" id="city" value="@Model.Friend?.Address?.City" readonly>
                    </div>
                    <div class="col-sm-3">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" class="form-control" id="country" value="@Model.Friend?.Address?.Country"
                            readonly>
                    </div>
                </div>
                <div class="row g-1">
                    <h3 class="pb-2">Quotes</h3>

                    <div class="row mb-2 text-center">
                        <div class="col-md-12 themed-grid-head-col">Quotes</div>
                    </div>
                    @if (Model.Friend?.Quotes != null)
                    {
                        @foreach (var item in Model.Friend.Quotes)
                        {
                            <div class="row mb-2 text-center">
                                <div class="col-md-12 themed-grid-col">
                                    @item.QuoteText
                                    <div class="text-end">
                                        — @item.Author
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="row g-1">
                    <h3 class="pb-2">Pets</h3>
                    <div class="row mb-2 text-center">
                        <div class="col-md-10 themed-grid-head-col">Type of animals</div>
                    </div>
                    @if (Model.Friend?.Pets != null && Model.Friend.Pets.Any())
                    {
                        foreach (var group in Model.Friend.Pets.GroupBy(p => p.Kind))
                        {
                            <div class="row mb-2 text-center">
                                <div class="col-md-10 themed-grid-col">
                                    @group.Count() @group.Key
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="row mb-2 text-center">
                            <div class="col-md-10 themed-grid-col">
                                No pets found.
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </form>
</div>